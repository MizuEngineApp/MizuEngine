                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#FFFFA033" Offset="0"/>
                                                                <GradientStop Color="#FFF26B0F" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="DA" FontSize="19" FontWeight="Black" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                                </Grid>
                                                <Image x:Name="DaImage" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="DonationAlerts" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="dalink.to/themrrain" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                <TextBlock Text="{DynamicResource donate.da.d}" Foreground="{DynamicResource SubText}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="14"
                                                       Foreground="{DynamicResource SubText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ===== Первый запуск: выбор темы ===== -->
                <Grid x:Name="FirstRun" Grid.ColumnSpan="2" Background="#99000000" Visibility="Collapsed">
                    <Border x:Name="FirstCard" Style="{StaticResource Panel}" Background="{DynamicResource WinBg}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Padding="32" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <StackPanel>
                            <Path Data="{StaticResource LogoM}" Fill="{StaticResource LogoBrush}" Stroke="#55FFFFFF" StrokeThickness="0.8"
                                  Width="48" Height="40" Stretch="Uniform"/>
                            <TextBlock Text="{DynamicResource first.title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock Text="{DynamicResource first.sub}" Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,6,0,22"/>
                            <WrapPanel x:Name="FirstThemes" HorizontalAlignment="Center" MaxWidth="720"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== Вышло обновление: плашка по центру, интерфейс за ней размыт. Крестик — напомнить при следующем запуске ===== -->
                <Grid x:Name="UpdateGate" Grid.ColumnSpan="2" Background="#55000000" Visibility="Collapsed">
                    <!-- Свернуть / спрятать в трей остаются доступны — плашка перекрывает обычные кнопки окна -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0">
                        <Button Style="{StaticResource CaptionBtn}" Content="&#xE921;" Click="Min_Click" Foreground="White"/>
                        <Button Style="{StaticResource CaptionBtn}" Content="&#xE8BB;" Click="Close_Click" Foreground="White"/>
                    </StackPanel>
                    <Border x:Name="GateCard" Style="{StaticResource Panel}" Background="{DynamicResource WinBg}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Padding="34,30" MaxWidth="500" RenderTransformOrigin="0.5,0.5" Effect="{DynamicResource CardShadow}">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <Grid>
                        <!-- Крестик: закрыть плашку, обновиться позже (она вернётся при следующем открытии окна или через 2 часа) -->
                        <Button x:Name="GateCloseBtn" Style="{StaticResource CaptionBtn}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Foreground="{DynamicResource Text}" Margin="0,-18,-22,0" Click="GateClose_Click" ToolTip="{DynamicResource upd.later}" Panel.ZIndex="1"/>
                        <StackPanel>
                            <Border Width="64" Height="64" CornerRadius="20" HorizontalAlignment="Center" Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource CardRim}" BorderThickness="1">
                                <TextBlock x:Name="GateArrow" Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="28" Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{DynamicResource upd.title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                            <TextBlock x:Name="GateVersions" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock Text="{DynamicResource upd.gate}" Style="{StaticResource Sub}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Text="{DynamicResource upd.howto}" Foreground="{DynamicResource SubText}" FontSize="12" TextWrapping="Wrap"
                                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,18"/>
                            <!-- «Что нового» — из описания релиза на GitHub -->
                            <Border x:Name="GateNotesBox" CornerRadius="12" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardRim}"
                                    BorderThickness="1" Padding="14,10" Margin="0,0,0,20" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource upd.notes}" FontWeight="SemiBold" FontSize="12.5"/>
                                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                        <TextBlock x:Name="GateNotes" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource SubText}"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="GateButtons">
                                <Button x:Name="GateInstallBtn" Style="{StaticResource PrimaryButton}" Content="{DynamicResource upd.install}" HorizontalAlignment="Center" Click="UpdInstall_Click"/>
                                <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Padding="18,9" Margin="0,10,0,0" Click="UpdOpen_Click">
                                    <TextBlock Text="{DynamicResource upd.github}" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                            <!-- Скачивание обновления: полоска и проценты -->
                            <StackPanel x:Name="GateProgress" Width="300" HorizontalAlignment="Center" Visibility="Collapsed">
                                <Grid Height="6">
                                    <Border CornerRadius="3" Background="{DynamicResource CardBg}"/>
                                    <Border x:Name="GateBar" CornerRadius="3" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                                <TextBlock x:Name="GateProgressText" Foreground="{DynamicResource SubText}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Снимок старой темы, который плавно тает при смене темы или языка -->
        <Image x:Name="FadeShot" IsHitTestVisible="False" Visibility="Collapsed" Stretch="Fill"/>
        <!-- Слой для «перелёта»: снимок элемента летит с одной страницы на другую -->
        <Canvas x:Name="FlyLayer" IsHitTestVisible="False" ClipToBounds="True"/>

        <!-- Уведомления о новых сообщениях (когда окно открыто) -->
        <StackPanel x:Name="NotifyHost" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22" Width="340"/>

        <!-- Всплывающее уведомление -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30" CornerRadius="16" Padding="18,11"
                Background="{DynamicResource WinBg}" BorderBrush="{DynamicResource CardRim}" BorderThickness="1"
                Effect="{DynamicResource CardShadow}" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource Accent}" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastText" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
