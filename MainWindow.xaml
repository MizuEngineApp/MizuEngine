<Window x:Class="MizuEngine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MizuEngine" Width="1160" Height="740" MinWidth="960" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="13"
        Foreground="{DynamicResource Text}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFA8D8FF" Offset="0"/>
            <GradientStop Color="#FF4A97FF" Offset="0.45"/>
            <GradientStop Color="#FF1E4FD8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LogoGloss" StartPoint="0,0" EndPoint="0.6,1">
            <GradientStop Color="#99FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.55"/>
        </LinearGradientBrush>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol</FontFamily>
        <QuinticEase x:Key="Ease" EasingMode="EaseOut"/>
        <BackEase x:Key="Spring" EasingMode="EaseOut" Amplitude="0.4"/>

        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,26,0,12"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
            <Setter Property="Margin" Value="0,14,0,10"/>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardRim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Тонкая полоса прокрутки под тему -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Width="5" CornerRadius="3" HorizontalAlignment="Center"
                                                    Background="{DynamicResource SubText}" Opacity="0.3"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="Width" To="8" Duration="0:0:0.2" EasingFunction="{StaticResource Ease}"/>
                                                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                    <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.35"/>
                                                        <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="Width" To="5" Duration="0:0:0.35" EasingFunction="{StaticResource Ease}"/>
                                                    </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Пункт меню слева. Выделение рисует отдельная «плашка», которая плавно ездит между пунктами -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="10" Background="{DynamicResource HoverBg}" Opacity="0"/>
                            <StackPanel Orientation="Horizontal" Margin="12,7">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource Icons}"
                                           FontSize="15" Width="24" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стеклянная карточка-кнопка: блик сверху, мягкое наведение, «пружинка» при нажатии -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                            <Border CornerRadius="18" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardRim}" BorderThickness="1"/>
                            <Border CornerRadius="18" Background="{DynamicResource CardShine}" IsHitTestVisible="False"/>
                            <Border x:Name="Hover" CornerRadius="18" Background="{DynamicResource HoverBg}" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.965" Duration="0:0:0.12" EasingFunction="{StaticResource Ease}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.965" Duration="0:0:0.12" EasingFunction="{StaticResource Ease}"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Spring}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Spring}"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                            <Border CornerRadius="12" Background="{DynamicResource Accent}"/>
                            <Border x:Name="Hover" CornerRadius="12" Background="#26FFFFFF" Opacity="0"/>
                            <ContentPresenter Margin="18,9" HorizontalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.12" EasingFunction="{StaticResource Ease}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.12" EasingFunction="{StaticResource Ease}"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Spring}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Spring}"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Тумблер: кружок плавно скользит, цвет плавно перетекает -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Grid Grid.Column="1" Width="46" Height="26">
                                <Border CornerRadius="13" Background="{DynamicResource TrackOff}" BorderBrush="{DynamicResource CardRim}" BorderThickness="1"/>
                                <Border x:Name="On" CornerRadius="13" Background="{DynamicResource Accent}" Opacity="0"/>
                                <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" Stroke="#26000000" StrokeThickness="0.8" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.42" EasingFunction="{StaticResource Ease}"/>
                                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.42" EasingFunction="{StaticResource Ease}"/>
                                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-«таблетка» для выбора одного варианта -->
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                            <Border CornerRadius="14" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardRim}" BorderThickness="1"/>
                            <Border x:Name="Hover" CornerRadius="14" Background="{DynamicResource HoverBg}" Opacity="0"/>
                            <Border x:Name="On" CornerRadius="14" Background="{DynamicResource Accent}" Opacity="0"/>
                            <ContentPresenter Margin="16,7"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.94" Duration="0:0:0.12" EasingFunction="{StaticResource Ease}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.94" Duration="0:0:0.12" EasingFunction="{StaticResource Ease}"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Spring}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Spring}"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ползунок: заполненная часть в цвет темы, кружок плавно увеличивается при наведении -->
        <Style x:Key="SliderSide" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="22">
                            <Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NiceSlider" TargetType="Slider">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="24">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderSide}" Background="{DynamicResource Accent}" Command="{x:Static Slider.DecreaseLarge}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderSide}" Background="{DynamicResource TrackOff}" Command="{x:Static Slider.IncreaseLarge}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="K" Width="20" Height="20" Fill="White" Stroke="#30000000" StrokeThickness="0.8" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                                            </Ellipse>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="K" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.18" Duration="0:0:0.25" EasingFunction="{StaticResource Ease}"/>
                                                        <DoubleAnimation Storyboard.TargetName="K" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.18" Duration="0:0:0.25" EasingFunction="{StaticResource Ease}"/>
                                                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                    <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="K" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Ease}"/>
                                                        <DoubleAnimation Storyboard.TargetName="K" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource Ease}"/>
                                                    </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поле ввода: стеклянное, с подсказкой (Tag) и плавной подсветкой при фокусе -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border CornerRadius="8" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardRim}" BorderThickness="1"/>
                            <Border x:Name="Focus" CornerRadius="8" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" Opacity="0"/>
                            <TextBlock x:Name="Ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Margin="{TemplateBinding Padding}" Padding="6,0,0,0"
                                       Foreground="{DynamicResource SubText}" Opacity="0.75" IsHitTestVisible="False" Visibility="Collapsed"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Focus" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Focus" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PassField" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border CornerRadius="8" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardRim}" BorderThickness="1"/>
                            <Border x:Name="Focus" CornerRadius="8" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" Opacity="0"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Focus" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Focus" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="8" Background="{DynamicResource HoverBg}" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Shell">
        <Border x:Name="Root" Background="{DynamicResource WinBg}" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- ===== Меню слева ===== -->
                <Border x:Name="SideCol" Background="{DynamicResource SideBg}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="14,18,14,18">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,20">
                            <!-- Иконка приложения (уменьшенная копия 4K-иконки) -->
                            <Image Width="30" Height="30" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Source>
                                    <BitmapImage UriSource="pack://application:,,,/Assets/MizuEngine_logo_128.png" DecodePixelWidth="96" CacheOption="OnLoad"/>
                                </Image.Source>
                            </Image>
                            <!-- Надпись мягко переливается тонами темы (градиент задаётся в коде и меняется вместе с темой) -->
                            <TextBlock x:Name="BrandText" Text="MizuEngine" FontSize="16.5" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,0,0,0">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF3DDC84" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="{DynamicResource status.ready}" Foreground="{DynamicResource SubText}" FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>

                        <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Hidden">
                        <Grid x:Name="NavGrid">
                            <Border x:Name="NavHighlight" VerticalAlignment="Top" Height="38" CornerRadius="10"
                                    Background="{DynamicResource NavSel}" BorderBrush="{DynamicResource CardRim}" BorderThickness="1">
                                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                            </Border>
                            <StackPanel x:Name="NavList">
                                <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="{DynamicResource nav.home}" IsChecked="True" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavSnow" Style="{StaticResource NavItem}" Tag="❄" Content="{DynamicResource nav.snow}" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavDock" Style="{StaticResource NavItem}" Tag="&#xE8A9;" Content="{DynamicResource nav.dock}" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavWe" Style="{StaticResource NavItem}" Tag="&#xE8B9;" Content="{DynamicResource nav.we}" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavWallpapers" Style="{StaticResource NavItem}" Tag="&#xE771;" Content="{DynamicResource nav.wallpapers}" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavLiveBg" Style="{StaticResource NavItem}" Tag="&#xE7F4;" Content="{DynamicResource nav.livebg}" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavPresets" Style="{StaticResource NavItem}" Tag="&#xE8F1;" Content="{DynamicResource nav.presets}" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavCustom" Style="{StaticResource NavItem}" Tag="&#xE790;" Content="{DynamicResource nav.custom}" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavAnim" Style="{StaticResource NavItem}" Tag="&#xE945;" Content="{DynamicResource nav.anim}" Checked="Nav_Checked"/>
                                <Border Height="1" Background="{DynamicResource Divider}" Margin="10,8"/>
                                <RadioButton x:Name="NavProfile" Style="{StaticResource NavItem}" Tag="&#xE77B;" Content="{DynamicResource nav.profile}" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavFriends" Style="{StaticResource NavItem}" Tag="&#xE716;" Content="{DynamicResource nav.friends}" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavChats" Style="{StaticResource NavItem}" Tag="&#xE8BD;" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource nav.chats}" VerticalAlignment="Center"/>
                                        <!-- Сколько непрочитанных сообщений (личные и группы) -->
                                        <Border x:Name="ChatsBadge" Visibility="Collapsed" Background="#FFFF3B30" CornerRadius="9" MinWidth="18" Height="18"
                                                Padding="5,0" Margin="7,-9,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                            <TextBlock x:Name="ChatsBadgeText" Foreground="White" FontSize="10.5" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavCommunity" Style="{StaticResource NavItem}" Tag="&#xE909;" Content="{DynamicResource nav.community}" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavLeaders" Style="{StaticResource NavItem}" Tag="&#xE728;" Content="{DynamicResource nav.leaders}" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavPlus" Style="{StaticResource NavItem}" Tag="&#xE710;" Content="{DynamicResource nav.plus}" Checked="Nav_Checked"/>
                                <Border Height="1" Background="{DynamicResource Divider}" Margin="10,8"/>
                                <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="{DynamicResource nav.settings}" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="{DynamicResource nav.about}" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavAuthor" Style="{StaticResource NavItem}" Tag="&#xE734;" Content="{DynamicResource nav.author}" Checked="Nav_Checked"/>
                                <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItem}" Tag="&#xE895;" Content="{DynamicResource nav.updates}" Checked="Nav_Checked"/>
                                <!-- Muzule: Claude и агенты внутри MizuEngine (только Mizu Plus) — в самом низу меню -->
                                <RadioButton x:Name="NavMuzule" Style="{StaticResource NavItem}" Tag="&#xE99A;" Content="{DynamicResource nav.muzule}" Checked="Nav_Checked"/>
                            </StackPanel>
                        </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ===== Правая часть ===== -->
                <Grid x:Name="MainCol" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0">
                        <Button Style="{StaticResource CaptionBtn}" Content="&#xE921;" Click="Min_Click"/>
                        <Button x:Name="MaxBtn" Style="{StaticResource CaptionBtn}" Content="&#xE922;" Click="Max_Click"/>
                        <Button Style="{StaticResource CaptionBtn}" Content="&#xE8BB;" Click="Close_Click"/>
                    </StackPanel>

                    <Grid x:Name="Pages" Grid.Row="1" Margin="36,0,22,26">

                        <!-- Главная -->
                        <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,14,0">
                                <Grid Height="200">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="440">
                                        <TextBlock Text="{DynamicResource home.title}" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{DynamicResource home.sub}" Style="{StaticResource Sub}" FontSize="15" Margin="0,10,0,0"/>
                                    </StackPanel>
                                    <!-- Стеклянная плитка-значок с буквой N и световой орбитой, цвета — от темы -->
                                    <Grid x:Name="Hero" Width="300" Height="200" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" CacheMode="BitmapCache">
                                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                                        <Grid RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform><RotateTransform Angle="-16"/></Grid.RenderTransform>
                                            <Ellipse Width="290" Height="78" Stroke="{DynamicResource RingBrush}" StrokeThickness="2.2" Opacity="0.75"/>
                                        </Grid>
                                        <Border Width="150" Height="150" CornerRadius="38" Background="{DynamicResource TileBg}" BorderBrush="{DynamicResource TileRim}" BorderThickness="1.5">
                                            <Grid>
                                                <Border CornerRadius="37" Margin="2" VerticalAlignment="Top" Height="70">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#40FFFFFF" Offset="0"/>
                                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Path Data="{StaticResource LogoM}" Fill="{DynamicResource LogoFill}" Stroke="#80FFFFFF" StrokeThickness="1"
                                                      Stretch="Uniform" Width="86" Height="72" Effect="{DynamicResource LogoGlow}"/>
                                            </Grid>
                                        </Border>
                                        <!-- передняя половина орбиты проходит поверх плитки -->
                                        <Grid RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                            <Grid.RenderTransform><RotateTransform Angle="-16"/></Grid.RenderTransform>
                                            <Ellipse Width="290" Height="78" Stroke="{DynamicResource RingBrush}" StrokeThickness="2.6">
                                                <Ellipse.Clip><RectangleGeometry Rect="0,39,290,40"/></Ellipse.Clip>
                                                <Ellipse.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="White" Opacity="0.8"/></Ellipse.Effect>
                                            </Ellipse>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <UniformGrid Columns="4" Margin="0,8,0,0">
                                    <Button Style="{StaticResource GlassButton}" Margin="0,0,9,0" Tag="NavSnow" Click="Go_Click">
                                        <StackPanel>
                                            <TextBlock Text="❄" FontSize="26" Foreground="{DynamicResource Accent}"/>
                                            <TextBlock Text="{DynamicResource nav.snow}" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,2"/>
                                            <TextBlock Text="{DynamicResource card.snow.d}" Foreground="{DynamicResource SubText}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GlassButton}" Margin="3,0,6,0" Tag="NavDock" Click="Go_Click">
                                        <StackPanel>
                                            <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{DynamicResource Accent}"/>
                                            <TextBlock Text="{DynamicResource nav.dock}" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,2"/>
                                            <TextBlock Text="{DynamicResource card.dock.d}" Foreground="{DynamicResource SubText}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GlassButton}" Margin="6,0,3,0" Tag="NavWe" Click="Go_Click">
                                        <StackPanel>
                                            <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{DynamicResource Accent}"/>
                                            <TextBlock Text="{DynamicResource nav.we}" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,2"/>
                                            <TextBlock Text="{DynamicResource card.we.d}" Foreground="{DynamicResource SubText}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GlassButton}" Margin="9,0,0,0" Tag="NavSettings" Click="Go_Click">
                                        <StackPanel>
                                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{DynamicResource Accent}"/>
                                            <TextBlock Text="{DynamicResource nav.settings}" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,2"/>
                                            <TextBlock Text="{DynamicResource card.settings.d}" Foreground="{DynamicResource SubText}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>

                                <TextBlock Text="{DynamicResource home.themes}" Style="{StaticResource H2}"/>
                                <WrapPanel x:Name="HomeThemes"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Зимний режим -->
                        <ScrollViewer x:Name="PageSnow" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,14,0">
                                <TextBlock Text="{DynamicResource nav.snow}" Style="{StaticResource H1}"/>
                                <TextBlock Text="{DynamicResource snow.sub}" Style="{StaticResource Sub}"/>

                                <Border Style="{StaticResource Panel}" Margin="0,22,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="SnowOn" Style="{StaticResource Switch}" Content="{DynamicResource snow.enabled}" FontWeight="SemiBold" Click="SnowOn_Click"/>
                                        <TextBlock Text="{DynamicResource fx.weather}" Style="{StaticResource Label}"/>
                                        <WrapPanel x:Name="WeatherPanel">
                                            <RadioButton Style="{StaticResource Pill}" GroupName="weather" Tag="snow" Content="{DynamicResource w.snow}" Click="Weather_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="weather" Tag="rain" Content="{DynamicResource w.rain}" Click="Weather_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="weather" Tag="sakura" Content="{DynamicResource w.sakura}" Click="Weather_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="weather" Tag="fireflies" Content="{DynamicResource w.fireflies}" Click="Weather_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="weather" Tag="blizzard" Content="{DynamicResource w.blizzard}" Click="Weather_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="weather" Tag="leaves" Content="{DynamicResource w.leaves}" Click="Weather_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="weather" Tag="roses" Content="{DynamicResource w.roses}" Click="Weather_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="weather" Tag="confetti" Content="{DynamicResource w.confetti}" Click="Weather_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="weather" Tag="bubbles" Content="{DynamicResource w.bubbles}" Click="Weather_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="weather" Tag="butterflies" Content="{DynamicResource w.butterflies}" Click="Weather_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="weather" Tag="pollen" Content="{DynamicResource w.pollen}" Click="Weather_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="weather" Tag="embers" Content="{DynamicResource w.embers}" Click="Weather_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="weather" Tag="stars" Content="{DynamicResource w.stars}" Click="Weather_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="weather" Tag="aurora" Content="{DynamicResource w.aurora}" Click="Weather_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="weather" Tag="matrix" Content="{DynamicResource w.matrix}" Click="Weather_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="weather" Tag="garland" Content="{DynamicResource w.garland}" Click="Weather_Click"/>
                                        </WrapPanel>
                                        <TextBlock Text="{DynamicResource snow.intensity}" Style="{StaticResource Label}"/>
                                        <WrapPanel x:Name="Levels">
                                            <RadioButton Style="{StaticResource Pill}" GroupName="lvl" Tag="120" Content="{DynamicResource lvl.light}" Click="Level_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="lvl" Tag="260" Content="{DynamicResource lvl.medium}" Click="Level_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="lvl" Tag="500" Content="{DynamicResource lvl.heavy}" Click="Level_Click"/>
                                            <RadioButton Style="{StaticResource Pill}" GroupName="lvl" Tag="900" Content="{DynamicResource lvl.blizzard}" Click="Level_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="OnWindows" Style="{StaticResource Switch}" Content="{DynamicResource snow.onwindows}" Click="SnowOption_Click"/>
                                        <CheckBox x:Name="Ground" Style="{StaticResource Switch}" Content="{DynamicResource snow.ground}" Click="SnowOption_Click"/>
                                        <CheckBox x:Name="Scrape" Style="{StaticResource Switch}" Content="{DynamicResource snow.scrape}" Click="SnowOption_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="Trail" Style="{StaticResource Switch}" Content="{DynamicResource fx.trail}" Click="SnowOption_Click"/>
                                        <TextBlock Text="{DynamicResource fx.trail.d}" Style="{StaticResource Sub}" FontSize="12" Margin="0,2,70,0"/>
                                        <CheckBox x:Name="React" Style="{StaticResource Switch}" Content="{DynamicResource fx.react}" Click="SnowOption_Click" Margin="0,14,0,0"/>
                                        <TextBlock Text="{DynamicResource fx.react.d}" Style="{StaticResource Sub}" FontSize="12" Margin="0,2,70,0"/>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource snow.clear}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="Clear_Click"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Док -->
                        <ScrollViewer x:Name="PageDock" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,14,0">
                                <TextBlock Text="{DynamicResource nav.dock}" Style="{StaticResource H1}"/>
                                <TextBlock Text="{DynamicResource dock.sub}" Style="{StaticResource Sub}"/>

                                <Border Style="{StaticResource Panel}" Margin="0,22,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="DockOn" Style="{StaticResource Switch}" Content="{DynamicResource dock.enabled}" FontWeight="SemiBold" Click="DockOn_Click"/>
                                        <TextBlock Text="{DynamicResource dock.enabled.d}" Style="{StaticResource Sub}" FontSize="12" Margin="0,2,70,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock x:Name="DockSizeValue" DockPanel.Dock="Right" Foreground="{DynamicResource SubText}"/>
                                            <TextBlock Text="{DynamicResource dock.size}"/>
                                        </DockPanel>
                                        <Slider x:Name="DockSizeSlider" Style="{StaticResource NiceSlider}" Minimum="32" Maximum="80" ValueChanged="DockSlider_Changed"/>

                                        <DockPanel Margin="0,18,0,8">
                                            <TextBlock x:Name="DockMagValue" DockPanel.Dock="Right" Foreground="{DynamicResource SubText}"/>
                                            <TextBlock Text="{DynamicResource dock.magnify}"/>
                                        </DockPanel>
                                        <Slider x:Name="DockMagSlider" Style="{StaticResource NiceSlider}" Minimum="100" Maximum="220" ValueChanged="DockSlider_Changed"/>

                                        <DockPanel Margin="0,18,0,8">
                                            <TextBlock x:Name="DockGlassValue" DockPanel.Dock="Right" Foreground="{DynamicResource SubText}"/>
                                            <TextBlock Text="{DynamicResource dock.transparency}"/>
                                        </DockPanel>
                                        <Slider x:Name="DockGlassSlider" Style="{StaticResource NiceSlider}" Minimum="0" Maximum="100" ValueChanged="DockSlider_Changed"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="DockAutohideSwitch" Style="{StaticResource Switch}" Content="{DynamicResource dock.autohide}" Click="DockOption_Click"/>
                                        <CheckBox x:Name="DockAnimSwitch" Style="{StaticResource Switch}" Content="{DynamicResource dock.anim}" Click="DockOption_Click"/>
                                        <CheckBox x:Name="DockClockSwitch" Style="{StaticResource Switch}" Content="{DynamicResource dock.clock}" Click="DockOption_Click"/>
                                        <CheckBox x:Name="DockBlurSwitch" Style="{StaticResource Switch}" Content="{DynamicResource dock.blur}" Click="DockOption_Click"/>
                                        <CheckBox x:Name="DockTraySwitch" Style="{StaticResource Switch}" Content="{DynamicResource dock.traytoggle}" Click="DockOption_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Док на других мониторах -->
                                <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="DockAllMonSwitch" Style="{StaticResource Switch}" Content="{DynamicResource dock.allmon}" FontWeight="SemiBold" Click="DockMon_Click"/>
                                        <TextBlock Text="{DynamicResource dock.allmon.d}" Style="{StaticResource Sub}" FontSize="12" Margin="0,2,70,0"/>
                                        <StackPanel x:Name="DockMonList" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                                    <TextBlock Text="{DynamicResource dock.hint}" Style="{StaticResource Sub}" FontSize="12.5" Margin="0" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Dynamic Island -->
                                <TextBlock Text="Dynamic Island" Style="{StaticResource H2}" Margin="0,28,0,0"/>
                                <TextBlock Text="{DynamicResource island.sub}" Style="{StaticResource Sub}"/>
                                <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="IslandOnSwitch" Style="{StaticResource Switch}" Content="{DynamicResource island.on}" FontWeight="SemiBold" Click="IslandOption_Click"/>
                                        <CheckBox x:Name="IslandMediaSwitch" Style="{StaticResource Switch}" Content="{DynamicResource island.media}" Click="IslandOption_Click"/>
                                        <CheckBox x:Name="IslandNotifySwitch" Style="{StaticResource Switch}" Content="{DynamicResource island.notify}" Click="IslandOption_Click"/>
                                        <CheckBox x:Name="IslandHideSwitch" Style="{StaticResource Switch}" Content="{DynamicResource island.hide}" Click="IslandOption_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Panel}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource island.fly}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource island.fly.d}" Style="{StaticResource Sub}" FontSize="12" Margin="0,4,40,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <RadioButton x:Name="IslandFlyUp" Style="{StaticResource Pill}" GroupName="islandfly" Content="{DynamicResource island.fly.up}" Click="IslandOption_Click" Margin="0,0,8,0"/>
                                            <RadioButton x:Name="IslandFlyDown" Style="{StaticResource Pill}" GroupName="islandfly" Content="{DynamicResource island.fly.down}" Click="IslandOption_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Wallpaper Engine -->
                        <Grid x:Name="PageWe" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource nav.we}" Style="{StaticResource H1}"/>
                                <TextBlock Text="{DynamicResource we.sub}" Style="{StaticResource Sub}"/>
                            </StackPanel>

                            <Border x:Name="WeMissing" Grid.Row="1" Style="{StaticResource Panel}" Visibility="Collapsed"
                                    VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="560" Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource we.missing}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource we.missing.d}" Style="{StaticResource Sub}"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource we.buy}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="BuyWe_Click"/>
                                </StackPanel>
                            </Border>

                            <DockPanel x:Name="WeFound" Grid.Row="1" Margin="0,18,0,0" Visibility="Collapsed">
                                <!-- На какой монитор ставить обои: схема мониторов с текущими обоями (видна, если мониторов больше одного) -->
                                <Border x:Name="WeMonPanel" DockPanel.Dock="Top" Style="{StaticResource Panel}" Margin="0,0,14,14" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource we.where}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="WeMonHint" Style="{StaticResource Sub}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        <Canvas x:Name="WeMonCanvas" Height="150" Margin="0,14,0,0" HorizontalAlignment="Left" ClipToBounds="False"/>
                                        <WrapPanel x:Name="WeMonChips" Margin="0,14,0,0"/>
                                    </StackPanel>
                                </Border>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,14,14">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{DynamicResource we.refresh}" Click="RefreshWe_Click"/>
                                    <TextBlock x:Name="WeCount" Foreground="{DynamicResource SubText}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ScrollViewer x:Name="WeScroll" VerticalScrollBarVisibility="Auto">
                                    <WrapPanel x:Name="WeGrid"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>

                        <!-- Сборки, профиль, друзья, чаты — содержимое строится в коде -->
                        <Grid x:Name="PagePresets" Visibility="Collapsed"/>
                        <Grid x:Name="PageProfile" Visibility="Collapsed"/>
                        <Grid x:Name="PageFriends" Visibility="Collapsed"/>
                        <Grid x:Name="PageChats" Visibility="Collapsed"/>
                        <Grid x:Name="PageCommunity" Visibility="Collapsed"/>
                        <Grid x:Name="PageLeaders" Visibility="Collapsed"/>
                        <Grid x:Name="PagePlus" Visibility="Collapsed"/>
                        <Grid x:Name="PageLive" Visibility="Collapsed"/>
                        <Grid x:Name="PageLiveBg" Visibility="Collapsed"/>
                        <!-- Muzule: строится в коде (Muzule/MuzulePage.cs) -->
                        <Grid x:Name="PageMuzule" Visibility="Collapsed"/>
                        <Grid x:Name="PageCustom" Visibility="Collapsed"/>
                        <Grid x:Name="PageAnim" Visibility="Collapsed"/>

                        <!-- Разделы в разработке -->
                        <StackPanel x:Name="PageSoon" Visibility="Collapsed">
                            <TextBlock x:Name="SoonTitle" Style="{StaticResource H1}"/>
                            <TextBlock Text="{DynamicResource soon.d}" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <!-- Настройки -->
                        <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="0,0,14,0" MaxWidth="760" HorizontalAlignment="Left">
                                <TextBlock Text="{DynamicResource nav.settings}" Style="{StaticResource H1}"/>
                                <!-- Вкладки настроек -->
                                <WrapPanel Margin="0,16,0,8">
                                    <RadioButton x:Name="SetTabGeneral" Style="{StaticResource Pill}" GroupName="settabs" Content="{DynamicResource set.tab.general}" IsChecked="True" Click="SetTab_Click" Margin="0,0,8,8"/>
                                    <RadioButton x:Name="SetTabSound" Style="{StaticResource Pill}" GroupName="settabs" Content="{DynamicResource set.tab.sound}" Click="SetTab_Click" Margin="0,0,8,8"/>
                                    <RadioButton x:Name="SetTabNotify" Style="{StaticResource Pill}" GroupName="settabs" Content="{DynamicResource set.tab.notify}" Click="SetTab_Click" Margin="0,0,8,8"/>
