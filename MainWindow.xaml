                                        <StackPanel>
                                            <TextBlock Text="&#xE716;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{DynamicResource Accent}"/>
                                            <TextBlock Text="{DynamicResource about.f3}" FontWeight="SemiBold" Margin="0,10,0,4" TextWrapping="Wrap"/>
